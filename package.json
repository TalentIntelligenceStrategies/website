{
  "name": "tis-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Build layer for tisglobalinc.com. The site is still hand-authored static HTML served from the repo root — this only builds the React islands, the Tailwind layer, and the vendored three.js / GSAP bundles into assets/build/.",
  "scripts": {
    "tokens": "node scripts/gen-tailwind-config.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "images": "node scripts/build-images.mjs",
    "search": "node scripts/build-search-index.mjs",
    "build": "npm run tokens && vite build && npm run fonts && npm run images && npm run search",
    "dev": "vite build --watch",
    "serve": "python3 -m http.server 8000",
    "verify": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "3.12.5",
    "lenis": "1.3.26",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1"
  }
}
